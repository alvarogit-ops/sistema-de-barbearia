# Copie este arquivo para .env e preencha. NUNCA commite o .env.
#
# Gere uma chave nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=troque-por-uma-chave-gerada-pelo-comando-acima
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# E-mail (em desenvolvimento, imprime no terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@barbergrid.com